generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum InvoiceStatus {
  PAID
  PARTIAL
  PENDING
  DRAFT
}

enum PaymentTerms {
  IMMEDIATE
  NET_7
  NET_15
  NET_30
  NET_45
  CUSTOM
}

// Employee lifecycle status (Invited / Pending live on Invitation, not here)
enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SystemRole {
  USER
  ADMIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- CORE TENANT (Organization) ---

model Shop {
  id               String  @id @default(cuid())
  businessName     String
  taxId            String?
  logoBase64       String? @db.Text
  subscriptionPlan Plan    @default(FREE)

  // Profile details
  ownerName String?
  phone     String?
  email     String?
  address   String?

  // Banking details
  bankName   String?
  accountNum String?
  ifscCode   String?
  upiId      String?

  // Invoice settings
  invoicePrefix     String @default("INV")
  invoiceFormat     String @default("INV-{YEAR}-{NUMBER}")
  currency          String @default("INR")
  footerMessage     String @default("Thank you for your business!")
  taxRate           Float  @default(18)
  nextInvoiceNumber Int    @default(1)
  businessType      String?
  licenseNum        String?
  aushadhLicenseNum String?
  khateLicenseNum   String?
  showPaymentTerms  Boolean @default(true)
  showQrCode        Boolean @default(true)
  showBankDetails   Boolean @default(true)
  showFooterMessage Boolean @default(true)
  showLicense       Boolean @default(true)
  showGst           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant relationships
  users        User[]
  customers    Customer[]
  products     Product[]
  invoices     Invoice[]
  branches     Branch[]
  departments  Department[]
  teams        Team[]
  roles        Role[]
  invitations  Invitation[]
  activityLogs ActivityLog[]
}

// --- ORGANIZATION HIERARCHY ---

model Branch {
  id             String  @id @default(cuid())
  name           String
  address        String?
  phone          String?
  isHeadquarters Boolean @default(false)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  users       User[]
  departments Department[]

  createdAt DateTime @default(now())

  @@index([shopId])
}

model Department {
  id   String @id @default(cuid())
  name String

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  users User[]
  teams Team[]

  createdAt DateTime @default(now())

  @@index([shopId])
}

model Team {
  id   String @id @default(cuid())
  name String

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  users User[]

  createdAt DateTime @default(now())

  @@index([shopId])
}

// --- ROLES & PERMISSIONS ---
// A Role is a reusable, named permission template. Permissions are the
// primary access primitive; roles merely bundle them for convenience.

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions String[] // array of permission keys (see lib/permissions/registry.js)
  isSystem    Boolean  @default(false) // seeded templates — cannot be deleted
  isArchived  Boolean  @default(false)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

// Per-user permission override. granted=true adds a permission on top of the
// role; granted=false revokes a permission the role would otherwise grant.
model UserPermission {
  id         String  @id @default(cuid())
  permission String
  granted    Boolean

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model User {
  id      String  @id @default(cuid())
  clerkId String  @unique
  name    String
  email   String  @unique
  phone   String?

  // Access control
  isOwner Boolean    @default(false) // org administrator — full access
  status  UserStatus @default(ACTIVE)
  systemRole SystemRole @default(USER)

  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Optional org placement
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Optional role template
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Per-user permission overrides
  permissionOverrides UserPermission[]

  activityLogs ActivityLog[]
  registrationRequest RegistrationRequest?

  createdAt DateTime @default(now())

  @@index([shopId])
}

// --- INVITATIONS (email-linked, pre-provisioned) ---

model Invitation {
  id    String @id @default(cuid())
  email String
  name  String?
  phone String?
  token String @unique

  status InvitationStatus @default(PENDING)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Pre-assigned org placement
  branchId     String?
  departmentId String?
  teamId       String?

  // Pre-assigned access
  isOwner     Boolean  @default(false)
  roleId      String?
  permissions String[] // explicit grants attached to the invite

  invitedById String?
  expiresAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([shopId])
}

// --- REGISTRATION REQUESTS ---

model RegistrationRequest {
  id           String   @id @default(cuid())
  businessName String
  taxId        String?
  phone        String?
  address      String?
  status       RegistrationStatus @default(PENDING)
  
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Future-ready fields
  adminNotes   String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- ACTIVITY LOG ---

model ActivityLog {
  id          String  @id @default(cuid())
  action      String // e.g. "invoice.create"
  entityType  String? // "Invoice"
  entityId    String?
  description String?
  metadata    Json?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([entityType, entityId])
}

// --- BUSINESS DATA ---

model Customer {
  id        String  @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  gstNumber String?
  notes     String?
  isDeleted Boolean @default(false)

  // Credit management
  creditLimit Float @default(0)
  creditUsed  Float @default(0)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@unique([phone, shopId])
}

model Product {
  id      String @id @default(cuid())
  name    String
  price   Float
  taxRate Float  @default(0)

  trackInventory Boolean @default(false)
  stockCount     Int?
  lowStockAlert  Int?
  imageBase64    String? @db.Text

  category    String?
  unit        String?
  isService   Boolean @default(false)
  description String?

  // Extended product fields
  sku         String?
  barcode     String?
  costPrice   Float?
  hsnSac      String?
  actualValue String?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  invoiceItems InvoiceItem[]
}

model Invoice {
  id         String @id @default(cuid())
  invoiceNum String

  discountPercentage Float         @default(0)
  totalTax           Float
  grandTotal         Float
  amountPaid         Float         @default(0)
  status             InvoiceStatus @default(PAID)

  // Credit sales fields
  paymentTerms  PaymentTerms @default(IMMEDIATE)
  dueDate       DateTime?
  customDueDays Int?

  notes String?

  isDeleted Boolean @default(false)

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  @@index([shopId, status])
  @@index([shopId, dueDate])
}

model InvoiceItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id              String   @id @default(cuid())
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String
  notes           String?
  referenceNumber String?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}
